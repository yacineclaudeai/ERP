PORT=3000
# Local embedded Postgres folder (ignored when DATABASE_URL is set)
DB_PATH=./data/pg
# DATABASE_URL=postgres://user:pass@localhost:5432/erp
# Long random string used to sign login sessions (required on Netlify)
SESSION_SECRET=change-me
# First admin account, created on first start if no user exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Lets the campaign-launch routine call /api/ads/* with "Authorization: Bearer <token>"
AUTOMATION_TOKEN=
