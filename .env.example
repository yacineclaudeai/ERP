PORT=3000
# Where the SQLite database file lives
DB_PATH=./data/erp.db
# Long random string used to sign login sessions
SESSION_SECRET=change-me
# First admin account, created on first start if no user exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Lets the campaign-launch routine call /api/ads/* with "Authorization: Bearer <token>"
AUTOMATION_TOKEN=
